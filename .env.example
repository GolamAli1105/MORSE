# .env.example
# Copy this file to .env and update with your values

# Application
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

# Database
SQLITE_DB_PATH=data/copilot.db
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=generative_copilot

# Models (HuggingFace model IDs)
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
MUSIC_MODEL=facebook/musicgen-small
TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Device (cuda or cpu)
DEVICE=cuda
CUDA_AVAILABLE=True

# RAG Settings
RAG_ENABLED=True
RAG_MIN_RATING=4.0
RAG_MAX_REFERENCES=5

# Fine-tuning
FINETUNING_MIN_SAMPLES=20
FINETUNING_EPOCHS=3
FINETUNING_BATCH_SIZE=4
FINETUNING_LEARNING_RATE=0.00002

# HuggingFace (optional, for private models)
# HUGGINGFACE_TOKEN=your_token_here
